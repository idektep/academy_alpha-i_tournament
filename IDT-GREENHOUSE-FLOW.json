    {
        "id": "bce1811510ae9cf9",
        "type": "function",
        "z": "57b3492b059d8ed0",
        "name": "To chart series",
        "func": "let p = msg.payload || {};\nlet msgs = [];\n\nlet ts = Date.now();  \n\nif (typeof p.temp_c !== 'undefined') {\n    msgs.push({ topic: 'temperature', payload: p.temp_c, timestamp: ts });\n}\nif (typeof p.humidity_pct !== 'undefined') {\n    msgs.push({ topic: 'humidity', payload: p.humidity_pct, timestamp: ts });\n}\nreturn [msgs];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 160,
