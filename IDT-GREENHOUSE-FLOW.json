        "name": "To Sensors",
        "func": "let p = msg.payload || {};\n\nlet ts = p.timestamp || null;\n\nlet mTemp = (p.temp_c !== undefined)\n    ? { payload: Number(p.temp_c).toFixed(2), timestamp: ts }\n    : null;\n\nreturn [mTemp];",
